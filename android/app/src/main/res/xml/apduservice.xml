<?xml version="1.0" encoding="utf-8"?>
<!-- HCE: serve the NFC Forum NDEF application AID so any Android NFC
     reader discovers this phone as a Type 4 Tag carrying the invite URL. -->
<host-apdu-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/nfc_service_name"
    android:requireDeviceUnlock="false">
    <aid-group
        android:category="other"
        android:description="@string/nfc_service_name">
        <aid-filter android:name="D2760000850101" />
    </aid-group>
</host-apdu-service>